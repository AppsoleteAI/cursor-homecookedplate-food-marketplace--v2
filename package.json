{
  "name": "expo-app",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --tunnel",
    "dev:server": "bun backend/server.ts",
    "dev:api": "wrangler dev --local --config wrangler.worker.toml --port 3000",
    "start-web": "expo start --web --tunnel",
    "share": "EXPO_TUNNEL_SUBDOMAIN=homecookedplate expo start --web --tunnel",
    "start-web-dev": "DEBUG=expo* expo start --web --tunnel",
    "lint": "expo lint",
    "pages:build": "expo export --platform web --output-dir dist && node scripts/assemble-pages.mjs",
    "postinstall": "patch-package",
    "lint:fix": "expo lint --fix",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "eslint --max-warnings=0"
    ]
  },
  "dependencies": {
    "@ai-sdk/react": "^2.0.76",
    "@cloudflare/workers-types": "^4.20260101.0",
    "@expo/vector-icons": "^15.0.3",
    "@hono/trpc-server": "^0.4.0",
    "@nkzw/create-context-hook": "^1.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@rork-ai/toolkit-sdk": "0.2.51",
    "@sentry/react-native": "~7.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@stripe/stripe-react-native": "0.50.3",
    "@supabase/supabase-js": "^2.76.1",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@tanstack/react-query": "^5.90.5",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@types/jest": "29.5.14",
    "@ungap/structured-clone": "^1.3.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~54.0.37",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.14",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
