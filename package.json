    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "hono": "^4.10.2",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "lucide-react-native": "^0.475.0",
