# Backend environment names.
# Live values go on the Worker plate-marketplace-api.
# Local boot: npm run dev:api
# That local process does not receive Worker secrets. See docs/SECRETS.md.
# Do not paste a real key into backend/.env.

# Public project URL. Safe to keep locally.
SUPABASE_URL=https://your-project.supabase.co

# Worker secret. Placeholder only. Do not put the real service-role key in a file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe secret is the Worker secret STRIPE_SECRET_KEY.
# Placeholder only.
STRIPE_SECRET_KEY=your-stripe-secret-key-here

# How it works:
# 1. You use ONE platform Stripe account (STRIPE_SECRET_KEY)
# 2. Each PlateMaker (seller) creates a "Connected Account" via Stripe Connect
# 3. When a buyer pays, money goes to the seller's Connected Account
# 4. Your platform automatically takes a fee (default 10%)
#
# To onboard sellers:
# - They must complete Stripe onboarding via the app
# - Use the trpc.payments.createConnectAccount API
# - Their account ID is saved in profiles.stripe_account_id
#
# Stripe webhook signing secret.
# Create the endpoint in Stripe, then store the signing secret as the Worker secret STRIPE_WEBHOOK_SECRET.
# Placeholder only. Do not paste the real value into this file.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here

# Auto-detect environment (test vs live)
# The system will automatically detect if you're using test or live keys
# based on whether the key is a test key or a live key

# Public anon key. Worker name: EXPO_PUBLIC_SUPABASE_ANON_KEY. Placeholder only.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Worker secrets. Placeholders only. Do not paste a real value.
RESEND_API_KEY=your-resend-key-here
OFFICIAL_EMAIL_FROM=Display Name <email@verified-domain.com>
METRO_WEBHOOK_SECRET=your-metro-webhook-secret-here
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=your-play-service-account-json-here
ASC_API_KEY_ID=your-asc-key-id-here
ASC_API_ISSUER_ID=your-asc-issuer-id-here
ASC_API_PRIVATE_KEY=your-asc-private-key-here
EXPO_ACCESS_TOKEN=your-expo-access-token-here
SENTRY_DSN=

# Plain Worker var. Not a secret.
EXPO_PUBLIC_WEB_URL=https://homecookedplate.com
