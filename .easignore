# EAS uses this file instead of .gitignore. .git and node_modules stay out by default.
# The patterns below keep the same secret and build-output exclusions as .gitignore.

# --- SENSITIVE DATA (CRITICAL) ---
.env
.env.local
.env.*
backend/.env
backend/.env.local
supabase/functions/**/.env
*.env
supabase_key.txt
service-role-key.json

# Allow .env.example files (templates should be committed)
!.env.example
!backend/.env.example

# --- DEPENDENCIES ---
node_modules/
backend/node_modules/
.bun/
bun.lockb

# --- EXPO & MOBILE ---
.expo/
dist/
web-build/
ios/
android/
*.jks
*.p12
*.key
*.mobileprovision

# --- SUPABASE & TOOLING ---
supabase/.temp/

# --- MAC/SYSTEM ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# --- BUILD OUTPUTS ---
backend/dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

